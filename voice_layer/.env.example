# Cartesia API Configuration
# Get your API key from https://play.cartesia.ai/keys
CARTESIA_API_KEY=your_cartesia_api_key_here

# STT Model (Cartesia Ink - ink-2 for real-time WebSocket, ink-whisper for batch)
CARTESIA_STT_MODEL=ink-2

# TTS Model (Cartesia Sonic - sonic-latest, sonic-3.5, etc.)
CARTESIA_TTS_MODEL=sonic-latest

# Cartesia Voice ID (e.g., standard British / American JARVIS-style assistant voice)
# Example: 79a125e8-cd45-4c13-8a67-188112f4dd22 (British Narrator) or custom voice ID
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22

# Language code (en, es, fr, de, etc.)
CARTESIA_LANGUAGE=en

# AeroGuard Ground Station Backend API Base URL
# web_UI.html polls http://localhost:8080/api/log
AEROGUARD_API_BASE_URL=http://localhost:8080

# AeroGuard Telemetry Data Mode ('mock' for offline simulated testing, 'live' for real GET /api/log)
AEROGUARD_DATA_MODE=mock

# LLM Configuration
# Providers supported: groq (recommended fast/free development), openai, openrouter, ollama, mock
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_groq_or_openai_api_key_here
# Optional custom base URL (e.g. for Ollama http://localhost:11434/v1 or OpenRouter)
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2

# Voice Layer Logging Level (DEBUG, INFO, WARNING, ERROR)
VOICE_LOG_LEVEL=INFO
